generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  color        String   @default("#f0508c")
  createdAt    DateTime @default(now())
  boards     Board[]
  posts      Post[]
  comments   Comment[]
  reactions  Reaction[]
}

model Board {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String   @default("")
  format         String   @default("wall") // wall|columns|grid|table|freeform|rows|timeline|stream|map
  wallpaper      String   @default("aurora")
  visibility     String   @default("public") // public|secret|private
  postColor      String   @default("#ffffff")
  allowComments  Boolean  @default(true)
  allowReactions Boolean  @default(true)
  reactionType   String   @default("like") // like|vote|star|grade
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sections       Section[]
  posts          Post[]
}

model Section {
  id       String @id @default(cuid())
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title    String @default("Section")
  position Int    @default(0)
  posts    Post[]
}

model Post {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @default("Anonymous")
  subject    String   @default("")
  body       String   @default("")
  color      String   @default("#ffffff")
  imageUrl   String?
  linkUrl    String?
  // freeform position
  x          Float    @default(40)
  y          Float    @default(40)
  // map position
  lat        Float?
  lng        Float?
  // ordering within wall/columns/rows/timeline/stream
  position   Int      @default(0)
  // table/timeline extra
  dateField  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comments   Comment[]
  reactions  Reaction[]
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @default("Anonymous")
  body       String
  createdAt  DateTime @default(now())
}

model Reaction {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userKey  String // session key to dedupe anonymous reactions
  value    Int    @default(1) // 1 for like/vote/star, 1-5 for grade

  @@unique([postId, userKey])
}
