# Copy to .env and fill in.

# SQLite database (default is fine for local dev)
DATABASE_URL="file:./dev.db"

# Signing secret for session cookies (change in production)
SESSION_SECRET="boardly-local-dev-secret"

# --- Optional: real AI board generation (OpenAI-compatible API) ---
# If LLM_API_KEY is set, "Create with AI" calls this endpoint; otherwise it
# uses the built-in offline generator. Works with any OpenAI-compatible server
# (OpenAI, Azure OpenAI-compatible gateways, OpenRouter, Together, Groq,
# local Ollama/LM Studio, etc.).
#
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"   # your custom base URL (no trailing slash)
# LLM_MODEL="gpt-4o-mini"                     # model name your endpoint expects
